local function autoFarmLoop()
    task.spawn(function()
        while State.AutoFarm or Config.AutoFarm do
            local ok, err = pcall(function()
                if getCharacter() then
                    local npc = getClosestNPC()
                    if npc and npc.hrp then
                        local killed = attackTarget(npc)
                        if npc.humanoid and npc.humanoid.Health <= 0 then
                            State.KillCount = (State.KillCount or 0) + 1
