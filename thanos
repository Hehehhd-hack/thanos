local function autoFarmLoop()
    task.spawn(function()
        while State.AutoFarm or Config.AutoFarm do
            if getCharacter() then
                local closest = getClosestNPC()
                if closest and closest.hrp then
                    local hrp = getHRP()
                    if hrp then
                        hrp.CFrame = closest.hrp.CFrame * CFrame.new(0, 0, 4)
                        local char = getCharacter()
                        if char then
                            local tool = char:FindFirstChildOfClass("Tool")
                            if tool then pcall(function() tool:Activate() end) end
                        end
                        pcall(function() LocalPlayer:GetMouse() mouse1click() end)
                        if closest.humanoid.Health <= 0 then
                            State.KillCount = (State.KillCount or 0) + 1
                        end
                    end
                end
            end
            task.wait(Config.FarmSpeed)
        end
    end)
end

