local function getCharacter()
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return nil end
    if char:FindFirstChild("Humanoid") and char.Humanoid.Health <= 0 then return nil end
    return char
end

local function getHRP()
    local char = getCharacter()
    if not char then return nil end
    return char:FindFirstChild("HumanoidRootPart")
end

local function getHumanoid()
    local char = getCharacter()
    if not char then return nil end
    return char:FindFirstChild("Humanoid")
end

local function teleportTo(position)
    local hrp = getHRP()
    if not hrp then return false end
    if typeof(position) == "CFrame" then
        hrp.CFrame = position
    elseif typeof(position) == "Vector3" then
        hrp.CFrame = CFrame.new(position)
    end
    return true
end

local function getNPCPositions()
    local npcs = {}
    for _, obj in pairs(Workspace:GetDescendants()) do
        if obj:IsA("Model") then
            local humanoid = obj:FindFirstChildOfClass("Humanoid")
            local hrp = obj:FindFirstChild("HumanoidRootPart")
            if humanoid and hrp and humanoid.Health > 0 then
                if not Players:GetPlayerFromCharacter(obj) then
                    table.insert(npcs, {
                        model = obj, humanoid = humanoid, hrp = hrp,
                        position = hrp.Position, name = obj.Name,
                    })
                end
            end
        end
    end
    return npcs
end

local function getClosestNPC(filter)
    local hrp = getHRP()
    if not hrp then return nil end
    local closest, closestDist, myPos = nil, math.huge, hrp.Position
    for _, npc in pairs(getNPCPositions()) do
        if filter and not filter(npc) then continue end
        local dist = (npc.position - myPos).Magnitude
        if dist < closestDist then
            closestDist = dist
            closest = npc
        end
    end
    return closest, closestDist
end

local function attackNPC(npc)
    local hrp = getHRP()
    if not hrp or not npc or not npc.hrp then return end
    hrp.CFrame = npc.hrp.CFrame * CFrame.new(0, 0, 3.5)
    local char = getCharacter()
    if char then
        local tool = char:FindFirstChildOfClass("Tool")
        if tool then pcall(function() tool:Activate() end) end
    end
    pcall(function()
        local mouse = LocalPlayer:GetMouse()
        mouse1click()
    end)
end

local function fireTouch(hit, target)
    if not hit or not target then return end
    pcall(function()
        firetouchinterest(hit, target, 0)
        task.wait(0.05)
        firetouchinterest(hit, target, 1)
    end)
end

