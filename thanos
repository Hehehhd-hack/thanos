    -- Drag with clamping
    local dragging, dragStart, startPos
    local function clampPosition(pos, obj)
        local vp = Workspace.CurrentCamera.ViewportSize
        local size = obj.AbsoluteSize
        local x = math.clamp(pos.X.Offset, -size.X + 60, vp.X - 60)
        local y = math.clamp(pos.Y.Offset, 0, vp.Y - 40)
        return UDim2.new(pos.X.Scale, x, pos.Y.Scale, y)
    end

    local function startDrag(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
           or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = Main.Position
        end
    end

    local function updateDrag(input)
        if not dragging then return end
        if input.UserInputType == Enum.UserInputType.MouseMovement
           or input.UserInputType == Enum.UserInputType.Touch then
            local delta = input.Position - dragStart
            local newPos = UDim2.new(
                startPos.X.Scale,
                startPos.X.Offset + delta.X,
                startPos.Y.Scale,
                startPos.Y.Offset + delta.Y
            )
            Main.Position = clampPosition(newPos, Main)
        end
    end

    local function endDrag(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
           or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end

