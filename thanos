local function getCharacter()
    local char = LocalPlayer.Character
    if not char then return nil end
    if not char:FindFirstChild("HumanoidRootPart") then return nil end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if hum and hum.Health <= 0 then return nil end
    return char
end

local function getHRP()
    local char = getCharacter()
    if not char then return nil end
    return char:FindFirstChild("HumanoidRootPart")
end

local function getHumanoid()
    local char = getCharacter()
    if not char then return nil end
    return char:FindFirstChildOfClass("Humanoid")
end

local function teleportTo(position)
    local hrp = getHRP()
    if not hrp then return false end
    local ok = pcall(function()
        if typeof(position) == "CFrame" then
            hrp.CFrame = position
        elseif typeof(position) == "Vector3" then
            hrp.CFrame = CFrame.new(position)
        end
    end)
    return ok
end

local function isValidNPC(obj)
    if not obj or not obj.Parent then return false end
    if not obj:IsA("Model") then return false end
    local hum = obj:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 then return false end
    if not obj:FindFirstChild("HumanoidRootPart") then return false end
    if Players:GetPlayerFromCharacter(obj) then return false end
    return true
end

local function getAllNPCs()
    local npcs = {}
    local ok, descendants = pcall(function()
        return Workspace:GetDescendants()
    end)
    if not ok then return npcs end

    for _, obj in ipairs(descendants) do
        if isValidNPC(obj) then
            table.insert(npcs, {
                model    = obj,
                humanoid = obj:FindFirstChildOfClass("Humanoid"),
                hrp      = obj:FindFirstChild("HumanoidRootPart"),
                name     = obj.Name,
            })
        end
    end
    return npcs
end

local function getClosestNPC(filterFn)
    local hrp = getHRP()
    if not hrp then return nil, math.huge end

    local closest, closestDist = nil, math.huge
    local myPos = hrp.Position

    for _, npc in ipairs(getAllNPCs()) do
        if filterFn and not filterFn(npc) then
            continue
        end
        local dist = (npc.hrp.Position - myPos).Magnitude
        if dist < closestDist then
            closestDist = dist
            closest = npc
        end
    end
    return closest, closestDist
end

local function fireTouch(hit, target)
    if not hit or not target then return end
    pcall(function()
        firetouchinterest(hit, target, 0)
        task.wait(0.03)
        firetouchinterest(hit, target, 1)
    end)
end

local function findObjectByTerms(terms, types)
    types = types or {"Model", "BasePart"}
    for _, obj in ipairs(Workspace:GetDescendants()) do
        local objName = obj.Name:lower()
        for _, term in ipairs(terms) do
            if objName:find(term) then
                for _, t in ipairs(types) do
                    if obj:IsA(t) then
                        return obj
                    end
                end
            end
        end
    end
    return nil
end

local function formatNumber(n)
    if n >= 1e9 then return string.format("%.2fB", n / 1e9) end
    if n >= 1e6 then return string.format("%.2fM", n / 1e6) end
    if n >= 1e3 then return string.format("%.2fK", n / 1e3) end
    return tostring(n)
end

local function formatTime(seconds)
    local h = math.floor(seconds / 3600)
    local m = math.floor((seconds % 3600) / 60)
    local s = math.floor(seconds % 60)
    return string.format("%02d:%02d:%02d", h, m, s)
end

local function safeGet(obj, path)
    local ok, result = pcall(function()
        local current = obj
        for segment in string.gmatch(path, "[^%.]+") do
            current = current[segment]
        end
        return current
    end)
    if ok then return result end
    return nil
end

