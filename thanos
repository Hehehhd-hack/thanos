-- ============================================
-- DPS CALCULATOR
-- ============================================

local function dpsLoop()
    task.spawn(function()
        while true do
            local now = os.clock()
            local totalDamage = 0
            for _, entry in ipairs(Config.DPSWindow) do
                if now - entry.time <= 5 then
                    totalDamage = totalDamage + entry.damage
                end
            end
            local dps = totalDamage / 5
            if dps > Config.DPSPeak then
                Config.DPSPeak = dps
            end
            Config.CurrentDPS = dps
            task.wait(0.5)
        end
    end)
end

