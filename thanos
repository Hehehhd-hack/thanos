local function autoCollectStonesLoop()
    task.spawn(function()
        while Config.AutoCollectStones or State.AutoCollectStones do
            local stoneTerms = {
                {name = "Space", terms = {"space stone", "spacestone"}},
                {name = "Reality", terms = {"reality stone", "realitystone"}},
                {name = "Time", terms = {"time stone", "timestone"}},
                {name = "Mind", terms = {"mind stone", "mindstone"}},
                {name = "Power", terms = {"power stone", "powerstone"}},
                {name = "Soul", terms = {"soul stone", "soulstone"}},
            }
            for _, stone in pairs(stoneTerms) do
                if not Config.StonesCollected[stone.name] then
                    for _, obj in pairs(Workspace:GetDescendants()) do
                        local n = obj.Name:lower()
                        for _, term in pairs(stone.terms) do
                            if n:find(term) then
                                if obj:IsA("Model") or obj:IsA("BasePart") then
                                    local part = obj:IsA("Model") and (obj:FindFirstChild("Handle") or obj:FindFirstChildWhichIsA("BasePart")) or obj
                                    if part then
                                        local hrp = getHRP()
                                        if hrp then
                                            hrp.CFrame = part.CFrame * CFrame.new(0, 3, 0)
                                            task.wait(0.3)
                                            fireTouch(hrp, part)
                                            Config.StonesCollected[stone.name] = true
                                        end
                                    end
                                end
                            end
                        end
                    end
                end
            end
            task.wait(2)
        end
    end)
end

